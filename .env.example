# Copy to .env for local server runs. Do not commit .env.
# Values are names only. Set the real ones in the Vercel project.
# None of the SUPABASE_* or auth secrets use a VITE_ prefix, so Vite will not ship them to the browser.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API Keys → Create new secret key
# (or the legacy service_role key). Server only. Bypasses RLS.
SUPABASE_SECRET_KEY=

# Supabase → Project Settings → Database → Connection string → Session pooler (URI)
# Better Auth sessions and tic-tac-toe live in this Postgres. npm run build applies migrations/ when this is set.
DATABASE_URL=

# Any long random string, for example: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public https origin of the Vercel deployment, no trailing slash.
BETTER_AUTH_URL=

# Keep sign-in on. Set to "false" only to disable accounts.
VITE_AUTH_ENABLED=true

# Optional. Google on the login screen uses the Grok auth broker.
# Email and password work without these.
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
